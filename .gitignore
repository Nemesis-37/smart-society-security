# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment
venv/
.venv/
env/
.env

# VS Code & IDEs
.vscode/
.idea/

# SQLite databases & runtime data
*.db-journal
*.db-wal
*.db-shm

# Private or local datasets & captures
dataset/private/
dataset/user_faces/
dataset/unknown/*
!dataset/unknown/.gitkeep

# Temporary & backup files
*.tmp
*.bak
*.swp

# Output test artifacts / logs
*.log
